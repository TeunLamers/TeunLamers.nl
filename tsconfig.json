{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@react/*": ["./src/components/react/*"],
      "@svelte/*": ["./src/components/svelte/*"],
      "@layouts/*": ["./src/layouts/*"]
    }
  }
}
